#!/bin/sh
# Pre-commit hook: enforce the CLAUDE.md rule "npx tsc --noEmit must pass
# before every commit", plus Prettier formatting. Installed via
# `git config core.hooksPath .githooks` (see README/CLAUDE.md).

echo "Running npx tsc --noEmit..."
npx tsc --noEmit
status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "tsc failed - commit aborted. Fix the type errors above, or skip this check with:"
  echo "  git commit --no-verify"
  exit 1
fi

echo "Running npm run lint..."
npm run lint
if [ $? -ne 0 ]; then
  echo ""
  echo "ESLint failed - commit aborted. Run 'npm run lint:fix', or skip with: git commit --no-verify"
  exit 1
fi

echo "Running npx prettier --check ..."
npx prettier --check .
status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "Prettier check failed - commit aborted. Run 'npm run format' to fix, or skip this check with:"
  echo "  git commit --no-verify"
  exit 1
fi

exit 0
