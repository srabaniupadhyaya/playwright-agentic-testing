{
  "attribution": {
    "commit": ""
  },
  "statusLine": {
    "type": "command",
    "command": "node .claude/statusline.js"
  },
  "permissions": {
    "allow": [
      "Bash(git diff*)",
      "Bash(git status)",
      "Bash(npm run *)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)",
      "Edit(.git/**)",
      "Write(.git/**)"
    ],
    "ask": [
      "Edit(playwright.config.ts)",
      "Write(playwright.config.ts)",
      "Read(./config/config.json)",
      "Edit(./config/config.json)",
      "Write(./config/config.json)",
      "Bash(git push*)",
      "Bash(git branch -D *)",
      "Bash(git commit --amend*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{try{const j=JSON.parse(d);const f=(j.tool_input&&j.tool_input.file_path)||(j.tool_response&&j.tool_response.filePath)||'';process.exit(/\\.tsx?$/.test(f)?0:1)}catch(e){process.exit(1)}})\" && npx tsc --noEmit 2>&1 | tail -n 30",
            "statusMessage": "Type-checking with tsc...",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
